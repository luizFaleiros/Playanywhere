<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="LoginPage" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #1a1a2e; -fx-background-radius: 15;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label layoutX="30.0" layoutY="30.0" text="🎮 PlayAnywhere GOG Edition" AnchorPane.topAnchor="30.0" AnchorPane.leftAnchor="30.0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #fff;">
         <font>
            <Font name="System Bold" size="32.0" />
         </font>
      </Label>
      
      <Label layoutX="750.0" layoutY="40.0" text="Ver. 1.0-SNAPSHOT" AnchorPane.rightAnchor="30.0" style="-fx-font-size: 16px; -fx-text-fill: #888;">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      
      <!-- Painel Central de Login -->
      <VBox alignment="CENTER" layoutX="250.0" layoutY="150.0" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="200.0" AnchorPane.topAnchor="150.0" AnchorPane.bottomAnchor="150.0" spacing="25">
         <children>
            <Label text="🔐 Conecte-se à sua conta GOG" style="-fx-text-fill: #ffffff; -fx-font-size: 22px; -fx-font-weight: bold;" />
            <Label text="Acesse sua biblioteca de jogos e instale em qualquer dispositivo" style="-fx-text-fill: #a0a0b0; -fx-font-size: 14px;" />
            
            <Button fx:id="loginButton" prefWidth="300.0" prefHeight="50.0" text="Entrar" onAction="#handleLogin" style="-fx-background-color: #5c2d91; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" />
            
            <!-- Status da autenticação -->
            <Label fx:id="statusLabel" text="🔘 Aguardando autenticação..." style="-fx-text-fill: #ffd700; -fx-font-size: 14px;" />
         </children>
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>